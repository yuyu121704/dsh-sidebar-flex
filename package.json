{
  "name": "dsh-sidebar-flex",
  "version": "0.2.2",
  "description": "Resizable, persisted navigation-list height for the DeepSeek Harness GUI sidebar, so the workspace/session list gets the vertical space it needs.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "author": "yuyu121704",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-bundle",
    "sidebar",
    "layout",
    "resize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyu121704/dsh-sidebar-flex.git"
  },
  "homepage": "https://github.com/yuyu121704/dsh-sidebar-flex#readme",
  "bugs": {
    "url": "https://github.com/yuyu121704/dsh-sidebar-flex/issues"
  }
}
